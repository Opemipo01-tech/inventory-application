<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inventory Categories</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>

    <a href="/new-category"> Add Category </a>
    
<div class="container">

    <h1><%= title %></h1> 


    <% categories.forEach((category) => { %>

        <div class="category-card">

            <h3>Category Name: <%= category.name %></h3>

            <p>Description: <%= category.description %></p>

            <small>
                Date Added:<%= category.added.toLocaleString() %>
            </small>


        </div>

        <a href="/categories/<%= category.id %>/update">Update Category</a>

        <a href="/items/<%= category.id %>">View Items</a>

        <form class="delete-form" action="/categories/<%= category.id %>/delete" method="POST">
            <button type="submit">Delete Category</button>
        </form>
        
    <% }) %>


</div>


</body>
</html>